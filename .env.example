# Comma-separated bot tokens from @BotFather, one per bot. Each bot must be a channel admin.
TELEGRAM_BOT_TOKENS=
# Private channel id where the bot stores objects, e.g. -1001234567890
STORAGE_CHANNEL_ID=
# Comma-separated Telegram user ids allowed to use the bot, e.g. 123456789
OWNER_IDS=
# 32-byte AES key, base64. Generate: bun -e 'console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("base64"))'
MASTER_KEY=
# HTTP port for the API
PORT=8080
# Admin API bearer token (32-256 printable ASCII, no spaces). Empty disables /v1/admin. Generate: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
ADMIN_TOKEN=
# SQLite index path (outside Docker; compose sets /data/index.sqlite)
DB_PATH=./data/index.sqlite
# Telegram Bot API base URL
TELEGRAM_API_BASE=https://api.telegram.org
# How often the index snapshot is flushed to Telegram, in ms
SNAPSHOT_INTERVAL_MS=60000
# Largest object PUT and the owner bot accept, in bytes (default 5 GiB)
MAX_OBJECT_BYTES=5368709120
# Minimum gap between channel writes, in ms (20 writes/min = 3000)
CHANNEL_MIN_INTERVAL_MS=3000
# Max bytes of encrypted uploads waiting for a channel slot before PUT returns 503
QUEUE_MAX_BYTES=67108864
# Set to false to disable the owner bot long polling
BOT_POLLING=true
